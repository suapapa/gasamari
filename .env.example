# Public site URL (required in Docker/production — never use 0.0.0.0)
APP_URL=http://localhost:3000

# Spotify OAuth credentials (DO NOT use the real secret here; store in actual .env)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/callback/spotify

# Server-only: Next.js /api/lyrics proxies to FastAPI (runtime, not baked into client)
# Local (pnpm next + uvicorn on host): http://127.0.0.1:8000
# docker compose ignores this and forces http://api:8000 inside the web container
API_BASE_URL=http://127.0.0.1:8000

# Backend settings
LYRICS_CACHE_DIR=./cache/lyrics
CORS_ORIGINS=http://localhost:3000
