# Root environment example — copy to .env.local for web, .env for api as needed.

# Public site URL (required in Docker/production — never use 0.0.0.0)
APP_URL=http://localhost:3000

# Spotify OAuth credentials (DO NOT use the real secret here; store in actual .env)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/callback/spotify

# Frontend public API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend settings
LYRICS_CACHE_DIR=./cache/lyrics
CORS_ORIGINS=http://localhost:3000
